# Relay keeps environment variables to the bare minimum. Everything else
# (providers and their API keys, email, budgets, security policy, retention...)
# is configured in the admin UI and stored encrypted in the database.

# ---- Required ----
# Database engine: "postgres" or "mongodb"
DB_TYPE=postgres
# postgres://user:pass@host:5432/relay?sslmode=require   or   mongodb://user:pass@host:27017/relay
DATABASE_URL=postgres://relay:relay@localhost:5432/relay
# 32-byte base64 master key. Generate with: npm run gen:key
# Keep it in a secret store (Azure Key Vault / Docker secret). Losing it = losing every stored secret.
RELAY_MASTER_KEY=

# ---- Optional ----
# Previous master key while rotating (decrypt-only). See docs/security.md.
# RELAY_MASTER_KEY_PREVIOUS=
# HTTP port (Azure sets PORT / WEBSITES_PORT automatically)
PORT=8080
# Number of proxy hops in front of Relay (1 behind Azure App Service / nginx) so client IPs are correct
# TRUST_PROXY=1
# Worker processes per container: a number or "auto" (one per CPU core)
# RELAY_WORKERS=auto
# LOG_LEVEL=debug
# "production" in deployed environments (secure cookies, production behaviour)
# NODE_ENV=production

# ---- Azure App Service (Node.js code deployment) ----
# Set these under Web App -> Settings -> Environment variables, not in a .env file.
# Use Key Vault references for secrets, e.g.
#   DATABASE_URL     = @Microsoft.KeyVault(SecretUri=https://<vault>.vault.azure.net/secrets/relay-database-url/)
#   RELAY_MASTER_KEY = @Microsoft.KeyVault(SecretUri=https://<vault>.vault.azure.net/secrets/relay-master-key/)
# SCM_DO_BUILD_DURING_DEPLOYMENT=false   # the GitHub workflow deploys a prebuilt package
# NODE_ENV=production
# TRUST_PROXY=1
# RELAY_WORKERS=auto
# Also: startup command "node dist/main.js", health check path "/health". See docs/deployment-azure.md.

# ---- docker compose only ----
POSTGRES_PASSWORD=change-me
MONGO_PASSWORD=change-me
