{
  "name": "relay-llm-gateway",
  "version": "1.0.0",
  "description": "Relay - Internal LLM Gateway: one secure API in front of local and cloud LLMs with routing, metering, budgets, caching, PII redaction and guardrails.",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "build": "npm run build:api && npm run build:web",
    "build:api": "nest build",
    "build:web": "npm --prefix web run build",
    "start": "node dist/main.js",
    "admin": "node dist/cli.js",
    "dev": "nest start --watch",
    "dev:web": "npm --prefix web run dev",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "gen:key": "node -e \"console.log(require('crypto').randomBytes(32).toString('base64'))\""
  },
  "dependencies": {
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@node-rs/argon2": "^2.0.2",
    "cookie-parser": "^1.4.7",
    "helmet": "^8.1.0",
    "mongodb": "^6.16.0",
    "nodemailer": "^10.4.0",
    "pg": "^8.16.0",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.12",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.2",
    "@types/node": "^22.15.0",
    "@types/nodemailer": "^6.4.17",
    "@types/pg": "^8.15.2",
    "@types/qrcode": "^1.5.5",
    "typescript": "~5.9.3",
    "vitest": "^5.1.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
