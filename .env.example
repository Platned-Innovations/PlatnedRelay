# Relay keeps .env to the bare minimum. Everything else (providers, API keys,
# email, budgets, security policy...) is configured in the admin UI and stored
# encrypted in the database.

# Database: "postgres" or "mongodb"
DB_TYPE=postgres
# postgres://user:pass@host:5432/relay   or   mongodb://user:pass@host:27017/relay
DATABASE_URL=postgres://relay:relay@localhost:5432/relay

# 32-byte base64 master key used to derive encryption/HMAC keys.
# Generate with: npm run gen:key   -- KEEP THIS SECRET, losing it means losing all stored secrets.
RELAY_MASTER_KEY=

# Optional: previous master key while rotating (decrypt-only).
# RELAY_MASTER_KEY_PREVIOUS=

# HTTP port (Azure Web App sets PORT / WEBSITES_PORT automatically)
PORT=8080

# Optional: set to the number of proxy hops in front of Relay (e.g. 1 behind Azure front end / nginx)
# TRUST_PROXY=1
